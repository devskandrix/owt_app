#api
API_URL=http://192.168.0.55:4000/api/v1
BASE_URL=http://192.168.0.55:4000
# Chat socket server. Optional, defaults to BASE_URL. "localhost" is
# swapped for BASE_URL's host so a phone can reach it.
SOCKET_URL=http://localhost:4000

#zegocloud (voice / video calls) — AppID from the ZEGOCLOUD console.
# Never put the ServerSecret here.
ZEGO_APP_ID=
# Development: set the AppSign to sign in with it (project in Testing).
# Live: leave it empty (or set ZEGO_USE_TOKEN=true) to sign in with a token
# from GET /zego/token instead. Don't ship the AppSign in live builds.
ZEGO_APP_SIGN=
ZEGO_USE_TOKEN=false
